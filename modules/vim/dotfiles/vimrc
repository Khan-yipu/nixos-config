"" ================================
" Gruvbox Scheme
"" ================================
let g:gruvbox_contrast_dark='hard'
"colorscheme gruvbox
colorscheme retrobox
set bg=dark " set as dark mode

" Completion
" 1. 设置补全菜单行为
set completeopt=menu,noselect

" 2. 【触发补全】
" 将 Ctrl+m 映射为触发补全菜单
" 作用：在插入模式下按 Ctrl+m，强制弹出补全菜单
" 不再使用 emacs 快捷键 不用重映射
" inoremap <C-m> <C-n>

" 3. 【菜单内导航】
" 使用 Ctrl+j 和 Ctrl+k 在弹出的菜单中上下移动
" 逻辑：如果菜单可见，就移动选择；否则保持原有功能（如换行）
" inoremap <expr> <C-j> pumvisible() ? "\<C-n>" : "\<C-j>"
" inoremap <expr> <C-k> pumvisible() ? "\<C-p>" : "\<C-k>"

" =====================================
" vim expand region
map <CR> <Plug>(expand_region_expand)
map - <Plug>(expand_region_shrink)
" =====================================
" Visual Multi Cursor
" 在插件加载后配置映射
" 直接映射到插件的内部函数
let g:VM_maps = {}
let g:VM_maps['Find Under'] = '<C-M-n>'
let g:VM_maps['Find Subword Under'] = '<C-M-n>'
nmap <C-M-i> <Plug>(VM-Add-Cursor-Down)
nmap <C-M-u> <Plug>(VM-Add-Cursor-Up)

