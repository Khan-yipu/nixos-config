" 这一行可以把系统剪贴板和 vim 剪贴板联系起来
" 但是要保证 vim --version | grep clipboard 输出 + 
set clipboard=unnamedplus

set colorcolumn=64,65

" 下面这一行意味着默认使用 vim 的剪贴板
" set clipboard=unnamed 

" make Y to copy till the end of the line
nnoremap Y y$
" visual mode Y copy to system clipboard
" vnoremap Y "+y

" 显示光标行横线
set cursorline
set cursorcolumn
hi CursorLine term=underline cterm=underline gui=underline
" hi CursorLine cterm=NONE ctermbg=darkred ctermfg=white guibg=darkred guifg=white

set nocompatible
set scrolloff=5
set wrap 
set wildmenu
set showcmd

set termguicolors
" set t_Co=16
let &t_ut=''
set hlsearch
exec "nohlsearch"
set incsearch
set mouse=a
set number
set relativenumber
set ignorecase
set smartcase
set laststatus=2
set autochdir

noremap n nzz
noremap N Nzz
 
" 高亮打开
syntax on

" 打开文件检测
filetype on

" 设置 tab 键的宽度为 2 个空格
set tabstop=2
 
" 设置当输入 tab 时，实际插入的空格数为 2
set shiftwidth=2

" 将 tab 转换为空格
set expandtab
    
" （可选）设置自动缩进时使用空格而不是 tab
" set softtabstop=4
 
" 设置自动缩进
" set autoindent

" 设置使用 c/c++ 语言的自动缩进方式
set cindent

" leader space
let mapleader = " "

au BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g'\"" |   endif

noremap <leader><CR> :nohlsearch<CR>
noremap <leader>e :tabe<CR>:E<CR>

"" fast move the cursor and view the file 
" nnoremap J 6j
" nnoremap K 6k
inoremap jk <Esc>
nnoremap <leader>j J

