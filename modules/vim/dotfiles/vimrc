" Trigger configuration. You need to change this to something other than <tab> if you use one of the following:
" - https://github.com/Valloric/YouCompleteMe
" - https://github.com/nvim-lua/completion-nvim
" // default is to use <tab> but i want to use <c-w>
" let g:UltiSnipsExpandTrigger="<tab>" 
let g:UltiSnipsExpandTrigger="<C-S-w>" 
" // default is to use <c-b> but i want to use <c-w>
let g:UltiSnipsJumpForwardTrigger="<C-S-w>"
let g:UltiSnipsJumpBackwardTrigger="<C-S-z>"
let g:UltiSnipsSnippetDirectories=[$HOME.'/.config/vim/Ultisnips/', 'Ultisnips']
" If you want :UltiSnipsEdit to split your window.
let g:UltiSnipsEditSplit="vertical"
